{
  "manifest_version": 3,
  "name": "Full Page Screenshot to PDF 📸",
  "description": "Capture an entire webpage by stitching viewport screenshots into a crisp PDF and open it in a new tab.",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture page as PDF 📸"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
